# Copy to .env and fill in what you need. Every value is optional; never commit .env.
# Everything runs on-premises: no cloud service is called.

# Knowledge base (RAG)
CHROMA_PATH=data/chroma          # embedded store on disk
CHROMA_HOST=                     # set to use a Chroma server instead (docker compose, k8s)
CHROMA_PORT=8000
EMBEDDING_PROVIDER=hash          # hash | onnx | openai_compatible | local
EMBEDDING_MODEL=                 # local: multilingual-e5-small | bge-m3 | nomic-embed-text;
                                 # openai_compatible: an embedding model on an OpenAI-compatible
                                 # server, e.g. vLLM or Strata
EMBEDDING_MODEL_DIR=models/embeddings  # local: <dir>/<model>/model.onnx + tokenizer.json
EMBEDDING_BASE_URL=              # e.g. http://<gpu-host>:8001/v1 (keep the host name out of git)
EMBEDDING_API_KEY=               # only if your server requires one

# Agent backend (on-premises only)
LLM_PROVIDER=fake                # fake (scripted, no model) | openai_compatible | codex_cli
LLM_BASE_URL=                    # e.g. http://<gpu-host>:8000/v1 for vLLM (keep the host name out of git)
LLM_MODEL=                       # the served model name, as listed by GET /v1/models
LLM_API_KEY=                     # only if the server was started with --api-key
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_EXTRA_BODY=                  # JSON passed to the server, e.g. {"chat_template_kwargs": {"enable_thinking": false}}

# Temporary stand-in while the GPU host is offline: each agent turn runs `codex exec`.
# This sends prompts to a cloud model through your Codex subscription (the data is synthetic);
# it is not part of the on-premises design and is never used for reported results.
CODEX_MODEL=gpt-6-luna
CODEX_EFFORT=low

# Agent behaviour and logs
FACTORY_ENERGY_DB=data/plant.duckdb   # opened read-only by every tool
AGENT_MAX_STEPS=8
AGENT_MAX_INPUT_CHARS=4000
AGENT_ALLOW_WRITE=0              # 1 enables the write-class tool generate_report
AGENT_MAX_TOOL_CALLS=16          # tool calls per question; identical calls refused after 2
AGENT_QUARANTINE=1               # strip instruction-like text from retrieved passages (0 only for tests)
AGENT_OUTPUT_GUARD=1             # redact secrets and links, block system-prompt leaks (0 only for tests)
AGENT_LOG_DIR=logs/agent         # one JSONL file per run
MCP_TOOLS=                       # optional allow-list for the MCP server, e.g. get_demand,search_knowledge

# OpenTelemetry (optional): export spans over OTLP, e.g. to Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. http://localhost:4317
OTEL_SERVICE_NAME=factory-energy-agent

# HTTP service (python -m factory_energy api serve)
API_HOST=127.0.0.1               # 0.0.0.0 inside a container
API_PORT=8000
API_KEY=                         # when set, /ask, /tools and /mcp require the X-API-Key header
MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000   # Host headers accepted by /mcp (DNS-rebinding guard)
CHROMA_WAIT_SECONDS=60           # how long to wait for a Chroma server to come up
FACTORY_ENERGY_HOME=             # folder with config/ and docs/ when not running from a checkout
